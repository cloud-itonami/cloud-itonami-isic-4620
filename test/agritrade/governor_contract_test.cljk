(ns agritrade.governor-contract-test
  "The governor contract as executable tests. The single invariant
  under test:

    AgriTradeAdvisor never dispatches grain/feed/seed/fibre or live
    animals, or settles an invoice, the Agri Trading Governor would
    reject, `:delivery/dispatch`/`:invoice/settle` NEVER auto-commit at
    any phase, `:order/intake` (no direct capital risk) MAY auto-commit
    when clean, and every decision (commit OR hold) leaves exactly one
    ledger fact."
  (:require [kotoba.test :refer [deftest is testing]]
            [langgraph.graph :as g]
            [agritrade.store :as store]
            [agritrade.operation :as op]))

(defn- fresh []
  (let [db (store/seed-db)]
    [db (op/build db)]))

(def operator {:actor-id "op-1" :actor-role :trading-supervisor :phase 3})

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "op-1"}} {:thread-id tid :resume? true}))

(defn- verify!
  "Walks `subject` through biosecurity verify -> approve, leaving a
  biosecurity assessment on file. Uses distinct thread-ids per call site
  by suffixing `tid-prefix`."
  [actor tid-prefix subject]
  (exec-op actor (str tid-prefix "-verify") {:op :biosecurity/verify :subject subject} operator)
  (approve! actor (str tid-prefix "-verify")))

(deftest clean-intake-auto-commits
  (let [[db actor] (fresh)
        res (exec-op actor "t1"
                  {:op :order/intake :subject "ao-1"
                   :patch {:id "ao-1" :counterparty "Akita Grain Traders Co"}} operator)]
    (is (= :commit (get-in res [:state :disposition])))
    (is (= "Akita Grain Traders Co" (:counterparty (store/agri-order db "ao-1"))) "SSoT actually updated")
    (is (= 1 (count (store/ledger db))))))

(deftest biosecurity-verify-always-needs-approval
  (testing "biosecurity verify is never in any phase's :auto set -- always human approval, even when clean"
    (let [[db actor] (fresh)
          res (exec-op actor "t2" {:op :biosecurity/verify :subject "ao-1"} operator)]
      (is (= :interrupted (:status res)))
      (let [r2 (approve! actor "t2")]
        (is (= :commit (get-in r2 [:state :disposition])))
        (is (some? (store/assessment-of db "ao-1")))))))

(deftest fabricated-jurisdiction-is-held
  (testing "a biosecurity/verify proposal with no official spec-basis -> HOLD, never reaches a human"
    (let [[db actor] (fresh)
          res (exec-op actor "t3"
                    {:op :biosecurity/verify :subject "ao-2"} operator)]
      (is (= :hold (get-in res [:state :disposition])))
      (is (some #{:no-spec-basis} (-> (store/ledger db) first :basis)))
      (is (nil? (store/assessment-of db "ao-2")) "no assessment written"))))

(deftest delivery-without-assessment-is-held
  (testing "delivery/dispatch before any biosecurity verification -> HOLD (evidence incomplete)"
    (let [[db actor] (fresh)
          res (exec-op actor "t4" {:op :delivery/dispatch :subject "ao-1"} operator)]
      (is (= :hold (get-in res [:state :disposition])))
      (is (some #{:evidence-incomplete} (-> (store/ledger db) first :basis))))))

(deftest credit-uncleared-is-held-and-unoverridable
  (testing "a counterparty whose credit has not been cleared -> HOLD, and never reaches request-approval -- the leasing collateral-coverage discipline applied to counterparty credit"
    (let [[db actor] (fresh)
          _ (verify! actor "t5pre" "ao-3")
          res (exec-op actor "t5" {:op :delivery/dispatch :subject "ao-3"} operator)]
      (is (= :hold (get-in res [:state :disposition])) "settles immediately, no interrupt")
      (is (not= :interrupted (:status res)))
      (is (some #{:credit-uncleared} (-> (store/ledger db) last :basis)))
      (is (empty? (store/delivery-history db))))))

(deftest contract-missing-is-held-and-unoverridable
  (testing "an order with no contract-terms on file -> HOLD, and never reaches request-approval"
    (let [[db actor] (fresh)
          _ (verify! actor "t6pre" "ao-4")
          res (exec-op actor "t6" {:op :delivery/dispatch :subject "ao-4"} operator)]
      (is (= :hold (get-in res [:state :disposition])) "settles immediately, no interrupt")
      (is (not= :interrupted (:status res)))
      (is (some #{:contract-missing} (-> (store/ledger db) last :basis)))
      (is (empty? (store/delivery-history db))))))

(deftest counterparty-sanctions-flag-unresolved-is-held-and-unoverridable
  (testing "a counterparty that has not passed OFAC / equivalent sanctions screening -> HOLD, and never reaches request-approval (evaluated at both delivery and invoice)"
    (let [[db actor] (fresh)
          _ (verify! actor "t7pre" "ao-5")
          res (exec-op actor "t7" {:op :delivery/dispatch :subject "ao-5"} operator)]
      (is (= :hold (get-in res [:state :disposition])) "settles immediately, no interrupt")
      (is (not= :interrupted (:status res)))
      (is (some #{:counterparty-sanctions-flag-unresolved} (-> (store/ledger db) last :basis)))
      (is (empty? (store/delivery-history db))))))

(deftest phytosanitary-certificate-missing-is-held-and-unoverridable
  (testing "a grain (:plant) consignment with no phytosanitary certificate on file -> HOLD, and never reaches request-approval"
    (let [[db actor] (fresh)
          _ (verify! actor "t8pre" "ao-6")
          res (exec-op actor "t8" {:op :delivery/dispatch :subject "ao-6"} operator)]
      (is (= :hold (get-in res [:state :disposition])) "settles immediately, no interrupt")
      (is (not= :interrupted (:status res)))
      (is (some #{:phytosanitary-certificate-missing} (-> (store/ledger db) last :basis)))
      (is (empty? (store/delivery-history db))))))

(deftest animal-health-certificate-missing-is-held-and-unoverridable
  (testing "a livestock (:animal) consignment with no animal-health certificate on file -> HOLD, and never reaches request-approval"
    (let [[db actor] (fresh)
          _ (verify! actor "t9pre" "ao-8")
          res (exec-op actor "t9" {:op :delivery/dispatch :subject "ao-8"} operator)]
      (is (= :hold (get-in res [:state :disposition])) "settles immediately, no interrupt")
      (is (not= :interrupted (:status res)))
      (is (some #{:animal-health-certificate-missing} (-> (store/ledger db) last :basis)))
      (is (empty? (store/delivery-history db))))))

(deftest plant-order-never-tripped-by-animal-health-check
  (testing "a :plant consignment's delivery is never held by animal-health-certificate-missing, even though it has no :animal-health-certificate? set"
    (let [[db actor] (fresh)
          _ (verify! actor "t10pre" "ao-1")
          res (exec-op actor "t10" {:op :delivery/dispatch :subject "ao-1"} operator)]
      (is (= :interrupted (:status res)) "pauses for human approval -- governor is clean")
      (is (not (some #{:animal-health-certificate-missing :phytosanitary-certificate-missing}
                     (-> (store/ledger db) last :basis)))))))

(deftest animal-order-never-tripped-by-phytosanitary-check
  (testing "an :animal consignment's delivery is never held by phytosanitary-certificate-missing, even though it has no :phytosanitary-certificate? set"
    (let [[db actor] (fresh)
          _ (verify! actor "t11pre" "ao-7")
          res (exec-op actor "t11" {:op :delivery/dispatch :subject "ao-7"} operator)]
      (is (= :interrupted (:status res)) "pauses for human approval -- governor is clean")
      (is (not (some #{:animal-health-certificate-missing :phytosanitary-certificate-missing}
                     (-> (store/ledger db) last :basis)))))))

(deftest delivery-dispatch-always-escalates-then-human-decides
  (testing "a clean, fully-verified, credit-cleared, contract-on-file, certificate-on-file, sanctions-screened order still ALWAYS interrupts for human approval -- :delivery/dispatch is never auto"
    (let [[db actor] (fresh)
          _ (verify! actor "t12pre" "ao-1")
          r1 (exec-op actor "t12" {:op :delivery/dispatch :subject "ao-1"} operator)]
      (is (= :interrupted (:status r1)) "pauses for human approval even when governor-clean")
      (testing "approve -> commit, delivery record drafted"
        (let [r2 (approve! actor "t12")]
          (is (= :commit (get-in r2 [:state :disposition])))
          (is (true? (:dispatched? (store/agri-order db "ao-1"))))
          (is (= 1 (count (store/delivery-history db))) "one draft delivery record"))))))

(deftest invoice-settle-always-escalates-then-human-decides
  (testing "a clean, fully-verified, already-dispatched order still ALWAYS interrupts for human approval -- :invoice/settle is never auto"
    (let [[db actor] (fresh)
          _ (verify! actor "t13pre" "ao-1")
          _ (exec-op actor "t13deliver" {:op :delivery/dispatch :subject "ao-1"} operator)
          _ (approve! actor "t13deliver")
          r1 (exec-op actor "t13" {:op :invoice/settle :subject "ao-1"} operator)]
      (is (= :interrupted (:status r1)) "pauses for human approval even when governor-clean")
      (testing "approve -> commit, invoice record drafted"
        (let [r2 (approve! actor "t13")]
          (is (= :commit (get-in r2 [:state :disposition])))
          (is (true? (:invoiced? (store/agri-order db "ao-1"))))
          (is (= 1 (count (store/invoice-history db))) "one draft invoice record"))))))

(deftest delivery-dispatch-double-dispatch-is-held
  (testing "dispatching the same agri-order twice -> HOLD on the second attempt"
    (let [[db actor] (fresh)
          _ (verify! actor "t14pre" "ao-1")
          _ (exec-op actor "t14a" {:op :delivery/dispatch :subject "ao-1"} operator)
          _ (approve! actor "t14a")
          res (exec-op actor "t14" {:op :delivery/dispatch :subject "ao-1"} operator)]
      (is (= :hold (get-in res [:state :disposition])))
      (is (some #{:already-dispatched} (-> (store/ledger db) last :basis)))
      (is (= 1 (count (store/delivery-history db))) "still only the one earlier delivery"))))

(deftest invoice-settle-double-invoice-is-held
  (testing "settling the same agri-order's invoice twice -> HOLD on the second attempt"
    (let [[db actor] (fresh)
          _ (verify! actor "t15pre" "ao-1")
          _ (exec-op actor "t15deliver" {:op :delivery/dispatch :subject "ao-1"} operator)
          _ (approve! actor "t15deliver")
          _ (exec-op actor "t15a" {:op :invoice/settle :subject "ao-1"} operator)
          _ (approve! actor "t15a")
          res (exec-op actor "t15" {:op :invoice/settle :subject "ao-1"} operator)]
      (is (= :hold (get-in res [:state :disposition])))
      (is (some #{:already-invoiced} (-> (store/ledger db) last :basis)))
      (is (= 1 (count (store/invoice-history db))) "still only the one earlier invoice"))))

(deftest every-decision-leaves-one-ledger-fact
  (testing "write-only-through-ledger: N operations -> N ledger facts"
    (let [[db actor] (fresh)]
      (exec-op actor "a" {:op :order/intake :subject "ao-1"
                          :patch {:id "ao-1" :counterparty "Akita Grain Traders Co"}} operator)
      (exec-op actor "b" {:op :biosecurity/verify :subject "ao-2"} operator)
      (is (= 2 (count (store/ledger db)))
          "one commit + one hold, both recorded"))))
